# R19-02: the host[:port] the BROWSER used. It is forwarded unchanged to the backend so Spring's same-origin CORS
# check (Origin vs. request host/port) sees the real public origin: `$host` drops the port, which made every
# same-origin browser POST from a non-default port (drill :13000, custom FRONTEND_PORT, LAN IP) look cross-origin
# and fail with 403 "Invalid CORS request". `$host` is only the fallback for HTTP/1.0 clients that send no Host.
map $http_host $public_host {
    default $http_host;
    ""      $host;
}

# Public port for X-Forwarded-Port: the explicit port of the Host header, otherwise the port nginx accepted on.
map $public_host $forwarded_port {
    "~:(?<explicit_port>[0-9]+)$" $explicit_port;
    default                       ${APP_PUBLIC_PORT};
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

upstream classroom_backend {
    server backend:8080;
    ${SECOND_BACKEND_UPSTREAM}
    keepalive 64;
}

server {
    listen 80;
    server_name localhost;
    set_real_ip_from ${REAL_IP_TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    client_max_body_size 20m;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    # R8-01/R9-03: media/document downloads use short-lived presigned MinIO URLs fetched directly by
    # the browser (uploads already did this for PUT). connect-src/media-src/frame-src/object-src
    # therefore need to reach the same browser-facing MinIO origin the upload flow already uses.
    # That origin (MINIO_PUBLIC_ORIGIN) is derived in infra/compose.yaml from the same
    # MINIO_EXTERNAL_ENDPOINT/MINIO_PORT values the backend uses to issue presigned URLs, and is
    # substituted into this template at container start (see frontend/Dockerfile's ENTRYPOINT) -
    # it must never be hardcoded to a fixed host/port again. img-src/connect-src already allow
    # http:/https: broadly; media-src/frame-src/object-src are scoped narrower since they gate
    # active content (video/iframe/object playback).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: ${MINIO_PUBLIC_ORIGIN}; frame-src 'self' ${MINIO_PUBLIC_ORIGIN} https://www.youtube-nocookie.com https://drive.google.com; object-src 'none'; connect-src 'self' ${MINIO_PUBLIC_ORIGIN}; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls directly to the Spring Boot backend
    location /api/ {
        proxy_pass http://classroom_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # R19-02: keep the browser-facing host AND port (the backend only honours these X-Forwarded-* values from
        # this proxy: see TrustedForwardedHeaderFilter) and always overwrite whatever the client sent, including
        # the RFC 7239 `Forwarded` and `X-Forwarded-Prefix` headers, which are cleared so they can never be spoofed.
        proxy_set_header Host $public_host;
        proxy_set_header X-Forwarded-Host $public_host;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Real-IP $remote_addr;
        # Do not propagate a client-supplied forwarding chain to the application.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto ${APP_PUBLIC_SCHEME};
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 90s;
    }
}
