# SERVER_ADDRESS must be your DNS hostname pointing at this PC's public address.
# Router/NAT must forward TCP 80, 443 and 9443 to this machine before starting this overlay.
{
    admin off
    email {$TLS_EMAIL}
}
{$SERVER_ADDRESS} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy frontend:80
}
https://{$SERVER_ADDRESS}:9443 {
    reverse_proxy minio:9000
}
