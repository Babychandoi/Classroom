{
    admin off
    default_sni {$SERVER_ADDRESS:192.168.1.7}
}

{$SERVER_ADDRESS:192.168.1.7}, localhost {
    tls internal
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    handle {
        reverse_proxy frontend:80
    }
}

https://{$SERVER_ADDRESS:192.168.1.7}:9443 {
    tls internal
    reverse_proxy minio:9000
}
