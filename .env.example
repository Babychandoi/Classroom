# ==============================================================================
# ENVIRONMENT VARIABLES - DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION)
# ==============================================================================

# MySQL Configuration
MYSQL_ROOT_PASSWORD=local-dev-root-7f3a9d2e
MYSQL_DATABASE=classroom_db
MYSQL_USER=classroom_user
MYSQL_PASSWORD=local-dev-mysql-4c8b2e1a
MYSQL_PORT=3307

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=local-dev-mongo-6d1f9a3c
MONGO_INITDB_DATABASE=classroom_activity
MONGO_PORT=27017

# Neo4j Configuration. NEO4J_AUTH is derived from NEO4J_PASSWORD in compose.yaml (neo4j/<password>)
# so the two can never drift apart - do not set NEO4J_AUTH separately.
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# MinIO Configuration
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=local-dev-minio-3a7e1c9d
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=classroom-media

# Backend Configuration
BACKEND_PORT=8080
# REQUIRED. Generate your own unique value - do not copy this placeholder or any value ever
# published in this repo's docs/tests. The app refuses to start outside test/integration profiles
# if it detects a known sample secret. Minimum 32 characters. Example generator:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters-long
JWT_EXPIRATION_HOURS=24
# REQUIRED. Same rules as JWT_SECRET above - generate your own unique value.
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-a-unique-secret-at-least-32-characters-long

# Frontend Configuration
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Host binding. The stack publishes to loopback only; every demo switch below is
# OFF unless you add the demo overlay (infra/compose.demo.yaml). Widen this only
# for a network you control, and never together with the demo overlay.
# ------------------------------------------------------------------------------
HOST_BIND_ADDRESS=127.0.0.1

# Demo switches — fail closed. Prefer the documented overlay:
#   docker compose -f infra/compose.yaml -f infra/compose.demo.yaml --env-file infra/.env up -d --build
# Setting these to true here has the same effect and the same risk: fixed-password
# demo accounts (owner@classroom.local / Password123!), the navbar role switcher,
# and an operator-settled payment rail. Never enable in an internet-facing deployment.
DEMO_SEED_ENABLED=false
PAYMENT_SANDBOX_ENABLED=false
MOCK_PAYMENT_CHECKOUT_ENABLED=false
VITE_ENABLE_DEMO_LOGIN=false
